# Everything is optional when a sibling ../local-llm-platform checkout exists:
# its config/detected.json supplies backend, URL and model, and its model_client.py is reused.

# LOCAL_LLM_PLATFORM_DIR=../local-llm-platform

# --- model serving (overrides the platform's detection) ---
# LLM_BACKEND=ollama               # ollama | vllm
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=qwen3.5:4b             # required if there is no local-llm-platform checkout
# EMBEDDING_MODEL=nomic-embed-text  # optional; ranks candidate bullets per responsibility
# LLM_TIMEOUT_SECONDS=300
# LLM_NUM_CTX=8192                 # Ollama context window
# LLM_MAX_CONCURRENCY=2            # in-flight model requests (match OLLAMA_NUM_PARALLEL)

# --- storage ---
# DB_PATH=data/matcher.db

# --- input limits ---
# MAX_RESUME_CHARS=12000
# MAX_JD_CHARS=10000
# MIN_JD_CHARS=200

# --- JD fetching from URLs ---
# JD_FETCH_TIMEOUT_SECONDS=10
# JD_FETCH_RESPECT_ROBOTS=true      # LinkedIn's robots.txt disallows all bots; false lets you fetch it
# JD_FETCH_CACHE_TTL_SECONDS=3600
# JD_FETCH_USE_PLAYWRIGHT=true      # only if installed: pip install playwright && playwright install chromium

# --- frontend ---
# API_URL=http://localhost:8010

# --- scoring ---
# WEIGHT_SKILLS=0.45
# WEIGHT_EXPERIENCE=0.35
# WEIGHT_SENIORITY=0.20
# MAX_REWRITE_BULLETS=4
